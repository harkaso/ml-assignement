   "source": [
    "results_log = []\n",
    "confusion_matrices = {}\n",
    "\n",
    "THRESHOLD = 0.5\n",
    "EPOCHS = 10\n",
    "PATIENCE = 3\n",
    "# Configuration des expériences\n",
    "# Format: (Platform, Architecture, Class, TrainL, TestL, PosWeight, InputDim)\n",
    "experiments = [\n",
    "    # --- LINUX (Serveur) ---\n",
    "    ('Linux', 'MLP', MLP, train_loader_l, test_loader_l, pos_weight_l, len(data_linux['features']), 1.0),\n",
    "    ('Linux', 'CNN', CNN_1D, train_loader_l, test_loader_l, pos_weight_l, len(data_linux['features']), 1.0),\n",
    "    ('Linux', 'Attn', Self_Attention, train_loader_l, test_loader_l, pos_weight_l, len(data_linux['features']), 1.0),\n",
    "    \n",
    "    # --- RASPBERRY PI (Edge) ---\n",
    "    ('Pi', 'MLP', MLP, train_loader_p, test_loader_p, pos_weight_p, len(data_pi['features']), 0.5),\n",
    "    ('Pi', 'CNN', CNN_1D, train_loader_p, test_loader_p, pos_weight_p, len(data_pi['features']), 0.5),\n",
    "    ('Pi', 'Attn', Self_Attention, train_loader_p, test_loader_p, pos_weight_p, len(data_pi['features']), 0.5),\n",
    "]\n",
    "\n",
    "print(f\"🚀 DÉMARRAGE DU BENCHMARK COMPLET SUR {DEVICE}...\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "for platform, arch, model_cls, t_loader, v_loader, p_weight, in_dim, width_factor in experiments:\n",
    "    model_name = f\"Best_{platform}_{arch}\"\n",
    "    print(f\"\\n>>> Entraînement : {model_name} (Features: {in_dim})\")\n",
    "    \n",
    "    model = model_cls(input_dim=in_dim, width_factor=width_factor)\n",
    "    trained_model, history, train_time = train_model(\n",
    "        model, t_loader, v_loader, p_weight, \n",
    "        epochs=EPOCHS, patience=PATIENCE, model_name=model_name, threshold=THRESHOLD\n",
    "    )\n",
    "    \n",
    "    plt.figure(figsize=(12, 4))\n",
    "    \n",
    "    plt.subplot(1, 2, 1)\n",
    "    plt.plot(history['train_loss'], label='Train Loss')\n",
    "    plt.plot(history['val_loss'], label='Val Loss')\n",
    "    plt.title(f'{model_name} - Loss Curve')\n",
    "    plt.xlabel('Epochs')\n",
    "    plt.ylabel('Loss')\n",
    "    plt.legend()\n",
    "    \n",
    "    plt.subplot(1, 2, 2)\n",
    "    plt.plot(history['val_f1'], label='Val F1-Score', color='green')\n",
    "    plt.title(f'{model_name} - F1 Score')\n",
    "    plt.xlabel('Epochs')\n",
    "    plt.ylabel('F1')\n",
    "    plt.legend()\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    trained_model.eval()\n",
    "    \n",
    "    sample_input, _ = next(iter(v_loader))\n",
    "    sample_input = sample_input.to(DEVICE)\n",
    "    tracemalloc.start()\n",
    "    start_inf = time.time()\n",
    "    with torch.no_grad():\n",
    "        for _ in range(100):\n",
    "            _ = trained_model(sample_input)\n",
    "    end_inf = time.time()\n",
    "    current_mem, peak_mem = tracemalloc.get_traced_memory()\n",
    "    tracemalloc.stop()\n",
    "    inference_time_us = ((end_inf - start_inf) / (100 * sample_input.size(0))) * 1_000_000\n",
    "    memory_usage_mb = peak_mem / (1024 * 1024)\n",
    "    \n",
    "    model_path = f\"models/{model_name}.pth\"\n",
    "    size_kb = os.path.getsize(model_path) / 1024\n",
    "    \n",
    "    y_true = []\n",
    "    y_pred = []\n",
    "    y_probs = []\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        for inputs, labels in v_loader:\n",
    "            inputs = inputs.to(DEVICE)\n",
    "            outputs = trained_model(inputs)\n",
    "            probs = torch.sigmoid(outputs)\n",
    "            preds = (probs > THRESHOLD).cpu().numpy()\n",
    "            y_true.extend(labels.numpy())\n",
    "            y_pred.extend(preds)\n",
    "            y_probs.extend(probs.cpu().numpy())\n",
    "            \n",
    "    f1 = f1_score(y_true, y_pred)\n",
    "    prec = precision_score(y_true, y_pred)\n",
    "    rec = recall_score(y_true, y_pred)\n",
    "    acc = accuracy_score(y_true, y_pred)\n",
    "    try:\n",
    "        roc_auc = roc_auc_score(y_true, y_probs)\n",
    "    except:\n",
    "        roc_auc = 0.0\n",
    "    fpr, tpr, _ = roc_curve(y_true, y_probs)\n",
    "    \n",
    "    print(classification_report(y_true, y_pred, target_names=['Benign', 'Malicious'], digits=4))\n",
    "    cm = confusion_matrix(y_true, y_pred)\n",
    "    plt.figure(figsize=(6, 5))\n",
    "    cm_norm = cm.astype('float') / cm.sum(axis=1)[:, np.newaxis]\n",
    "    labels = [f\"{val}\\n({pct:.1f}%)\" for val, pct in zip(cm.flatten(), cm_norm.flatten())]\n",
    "    labels = np.asarray(labels).reshape(2,2)\n",
    "    sns.heatmap(cm, annot=labels, fmt='', cmap='Blues', cbar=False, \n",
    "            xticklabels=['Benign', 'Malicious'], yticklabels=['Benign', 'Malicious'])\n",
    "    plt.title(f\"Confusion Matrix - {model_name}\")\n",
    "    plt.ylabel('Réel')\n",
    "    plt.xlabel('Prédit')\n",
    "    plt.show()\n",
    "    \n",
    "    results_log.append({\n",
    "        'Platform': platform,\n",
    "        'Arch': arch,\n",
    "        'Accuracy': f\"{acc:.4f}\",\n",
    "        'F1-Score': f\"{f1:.4f}\",\n",
    "        'Precision': f\"{prec:.4f}\",\n",
    "        'Recall': f\"{rec:.4f}\",\n",
    "        'ROC-AUC': f\"{roc_auc:.4f}\",\n",
    "        'FPR': (cm[0,1] / (cm[0,1] + cm[0,0])) * 100,\n",
    "        'Inference': round(inference_time_us, 2),\n",
    "        'Size': round(size_kb, 1),\n",
    "        \"Memory Peak\": round(memory_usage_mb, 2),\n",
    "        'Train Time': round(train_time, 1)\n",
    "    })\n",
    "    confusion_matrices[f\"{model_name}_{platform}\"] = cm\n",
    "    \n",
    "    print(f\"-> Résultat : F1={f1:.4f} | Recall={rec:.4f} | AUC={roc_auc:.4f}\")\n",
    "    print(\"-\" * 60)"
   ]
  },
