   "source": [
    "import pandas as pd\n",
    "import torch\n",
    "import joblib\n",
    "import numpy as np\n",
    "import time\n",
    "import os\n",
    "\n",
    "# ==============================================================================\n",
    "# 1. SÉLECTION AUTOMATIQUE DU MEILLEUR MODÈLE (Depuis le CSV)\n",
    "# ==============================================================================\n",
    "print(\"🔍 Analyse du benchmark pour trouver le champion...\")\n",
    "\n",
    "try:\n",
    "    # Chargement du fichier de résultats\n",
    "    df_results = pd.read_csv(\"models/benchmark_results.csv\")\n",
    "    \n",
    "    # Nettoyage et conversion (au cas où ce soit des strings)\n",
    "    df_results['F1-Score'] = df_results['F1-Score'].astype(float)\n",
    "    df_results['Accuracy'] = df_results['Accuracy'].astype(float)\n",
    "    df_results['Precision'] = df_results['Precision'].astype(float)\n",
    "    df_results['Recall'] = df_results['Recall'].astype(float)\n",
    "    df_results['ROC-AUC'] = df_results['ROC-AUC'].astype(float)\n",
    "    df_results['FPR'] = df_results['FPR'].astype(float)\n",
    "    \n",
    "    # Filtrage pour la plateforme Linux uniquement\n",
    "    linux_results = df_results[df_results['Platform'] == 'Linux']\n",
    "    \n",
    "    if linux_results.empty:\n",
    "        raise ValueError(\"Aucun résultat pour 'Linux' trouvé dans le CSV.\")\n",
    "\n",
    "    # Tri par F1-Score décroissant -> Le premier est le meilleur\n",
    "    best_row = linux_results.sort_values(by='F1-Score', ascending=False).iloc[0]\n",
    "    \n",
    "    BEST_ARCH = best_row['Arch']\n",
    "    # On reconstruit le nom du fichier modèle sauvegardé\n",
    "    BEST_MODEL_PATH = f\"models/Best_Linux_{BEST_ARCH}.pth\"\n",
    "    \n",
    "    print(f\"🏆 CHAMPION DÉTECTÉ : Architecture {BEST_ARCH}\")\n",
    "    print(f\"   📊 F1-Score : {best_row['F1-Score']:.4f}\")\n",
    "    print(f\"   📂 Fichier  : {BEST_MODEL_PATH}\")\n",
    "\n",
    "except FileNotFoundError:\n",
    "    raise FileNotFoundError(\"Le fichier 'benchmark_results.csv' n'existe pas. Lance l'entraînement d'abord.\")\n",
    "\n",
    "# ==============================================================================\n",
    "# 2. CHARGEMENT DES RESSOURCES (Scaler & Modèle)\n",
    "# ==============================================================================\n",
    "print(\"\\n🛠️ Chargement des ressources système...\")\n",
    "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "# A. Charger le Scaler et la liste des Features\n",
    "try:\n",
    "    scaler = joblib.load('datasets/scaler_linux.pkl')\n",
    "    features_list = joblib.load('datasets/features_linux_list.pkl')\n",
    "    INPUT_DIM = len(features_list)\n",
    "    print(f\"   ✅ Scaler chargé. (Attend {INPUT_DIM} features)\")\n",
    "except FileNotFoundError:\n",
    "    raise FileNotFoundError(\"Les fichiers .pkl dans datasets/ sont manquants.\")\n",
    "\n",
    "# B. Instancier la bonne architecture\n",
    "# (Assure-toi que les classes MLP, CNN_1D, Self_Attention sont définies dans le notebook)\n",
    "if BEST_ARCH == 'MLP':\n",
    "    model = MLP(input_dim=INPUT_DIM, width_factor=1.0)\n",
    "elif BEST_ARCH == 'CNN':\n",
    "    model = CNN_1D(input_dim=INPUT_DIM, width_factor=1.0)\n",
    "elif BEST_ARCH == 'Attn':\n",
    "    model = Self_Attention(input_dim=INPUT_DIM, width_factor=1.0)\n",
    "else:\n",
    "    raise ValueError(f\"Architecture inconnue dans le CSV : {BEST_ARCH}\")\n",
    "\n",
    "# C. Charger les poids\n",
    "if not os.path.exists(BEST_MODEL_PATH):\n",
    "    raise FileNotFoundError(f\"Le fichier de poids {BEST_MODEL_PATH} est introuvable !\")\n",
    "\n",
    "model.load_state_dict(torch.load(BEST_MODEL_PATH, map_location=DEVICE))\n",
    "model.to(DEVICE)\n",
    "model.eval()\n",
    "print(f\"   ✅ Modèle {BEST_ARCH} chargé et prêt sur {DEVICE}.\")\n",
    "\n",
    "# ==============================================================================\n",
    "# 3. MOTEUR D'INFÉRENCE TEMPS RÉEL (Simulation)\n",
    "# ==============================================================================\n",
    "def preprocess_packet(row_dict, expected_features, scaler):\n",
    "    \"\"\"\n",
    "    Transforme une ligne brute (Series ou Dict) en tenseur PyTorch.\n",
    "    Correction du KeyError : Utilisation de reindex pour un alignement propre.\n",
    "    \"\"\"\n",
    "    # 1. Convertir en DataFrame et s'assurer que l'index est bien [0]\n",
    "    # On transforme la Series en DataFrame et on transpose pour avoir 1 ligne\n",
    "    df = pd.DataFrame(row_dict).transpose() if isinstance(row_dict, pd.Series) else pd.DataFrame([row_dict])\n",
    "    df.reset_index(drop=True, inplace=True)\n",
    "    \n",
    "    # 2. Nettoyage (Strip, Clipping, NaNs)\n",
    "    df.columns = df.columns.str.strip()\n",
    "    df.replace([np.inf, -np.inf], 1e9, inplace=True)\n",
    "    df.fillna(0, inplace=True)\n",
    "    \n",
    "    # 3. Alignement des colonnes (Critique !)\n",
    "    # Reindex garantit que l'ordre est correct et que les colonnes manquantes sont créées avec des 0\n",
    "    df_final = df.reindex(columns=expected_features, fill_value=0)\n",
    "    \n",
    "    # 4. Scaling\n",
    "    # On s'assure que les données sont en float pour le scaler\n",
    "    X_scaled = scaler.transform(df_final.astype(float))\n",
    "    \n",
    "    # 5. Conversion en Tenseur\n",
    "    return torch.tensor(X_scaled, dtype=torch.float32).to(DEVICE)\n",
    "\n",
    "# ==============================================================================\n",
    "# 4. LANCEMENT DE LA SIMULATION SUR 'capture_linux.csv'\n",
    "# ==============================================================================\n",
    "CAPTURE_FILE = \"datasets/capture_linux.csv\"\n",
    "print(f\"\\n📡 Démarrage de la surveillance sur : {CAPTURE_FILE}\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "if not os.path.exists(CAPTURE_FILE):\n",
    "    print(f\"❌ ERREUR : Le fichier {CAPTURE_FILE} n'existe pas.\")\n",
    "    print(\"👉 Lance d'abord le script Scapy (Cellule précédente) pour générer du trafic.\")\n",
    "else:\n",
    "    # Lecture du fichier de capture\n",
    "    traffic_df = pd.read_csv(CAPTURE_FILE)\n",
    "    \n",
    "    alerts = 0\n",
    "    start_time = time.time()\n",
    "    \n",
    "    print(f\"Flux à analyser : {len(traffic_df)}\")\n",
    "    print(\"-\" * 70)\n",
    "    print(f\"{'TIMESTAMP':<10} | {'PROBABILITÉ':<12} | {'STATUS':<10}\")\n",
    "    print(\"-\" * 70)\n",
    "\n",
    "    for idx, row in traffic_df.iterrows():\n",
    "        # Simulation d'arrivée en temps réel (optionnel, pour l'effet)\n",
    "        # time.sleep(0.02) \n",
    "        \n",
    "        # Prétraitement\n",
    "        input_tensor = preprocess_packet(row, features_list, scaler)\n",
    "        \n",
    "        # Prédiction\n",
    "        with torch.no_grad():\n",
    "            output = model(input_tensor)\n",
    "            prob = torch.sigmoid(output).item()\n",
    "        \n",
    "        # Logique d'alerte\n",
    "        timestamp = time.strftime(\"%H:%M:%S\")\n",
    "        \n",
    "        if prob > 0.8: # SEUIL D'ALERTE\n",
    "            alerts += 1\n",
    "            print(f\"🚨 {timestamp} | {prob:.4f}       | MALICIOUS\")\n",
    "        else:\n",
    "            # On n'affiche pas tout pour ne pas spammer, juste un indicateur visuel\n",
    "            # ou on affiche les flux bénins avec une faible probabilité\n",
    "            if idx % 10 == 0: # type: ignore # Affiche 1 flux bénin sur 10 pour montrer que ça vit\n",
    "                print(f\"   {timestamp} | {prob:.4f}       | Benign\")\n",
    "\n",
    "    duration = time.time() - start_time\n",
    "    print(\"=\"*70)\n",
    "    print(f\"✅ Analyse terminée en {duration:.2f} secondes.\")\n",
    "    print(f\"📊 Bilan : {len(traffic_df)} flux analysés, {alerts} ALERTES générées.\")"
   ]
  }
 ],
