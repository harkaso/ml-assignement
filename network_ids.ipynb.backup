    "import os\n",
    "import random\n",
    "import time\n",
    "import copy\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import tracemalloc\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.optim as optim\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "from torchvision.ops import sigmoid_focal_loss\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "from sklearn.metrics import confusion_matrix, accuracy_score\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.preprocessing import QuantileTransformer\n",
    "from sklearn.metrics import f1_score, precision_score, recall_score, confusion_matrix, classification_report, roc_curve, roc_auc_score\n",
    "from tqdm import tqdm\n",
    "import glob\n",
    "import joblib\n",
    "\n",
    "SEED = 42\n",
    "\n",
    "def set_seed(seed=42):\n",
    "    random.seed(seed)\n",
    "    np.random.seed(seed)\n",
    "    torch.manual_seed(seed)\n",
    "    torch.cuda.manual_seed_all(seed)\n",
    "    # Pour des convolutions déterministes (peut ralentir légèrement mais essentiel pour la science)\n",
    "    torch.backends.cudnn.deterministic = True\n",
    "    torch.backends.cudnn.benchmark = False\n",
    "    print(f\"[INFO] Global Seed set to {seed}\")\n",
    "\n",
    "# 2. Gestion de l'environnement et des dossiers\n",
    "def setup_env():\n",
    "    \"\"\"Crée l'arborescence nécessaire si elle n'existe pas.\"\"\"\n",
    "    directories = ['datasets', 'models']\n",
    "    for d in directories:\n",
    "        os.makedirs(d, exist_ok=True)\n",
    "        print(f\"[INFO] Dossier vérifié/créé : {d}/\")\n",
    "    \n",
    "    # Vérification du dossier Input (Juste un warning si absent, car c'est l'utilisateur qui fournit les données)\n",
    "    if not os.path.exists('CIC-IDS-2017/'):\n",
    "        print(\"[WARNING] Le dossier input 'CIC-IDS-2017/' est introuvable. Assurez-vous d'y placer vos CSV.\")\n",
    "    else:\n",
    "        print(\"[INFO] Dossier input 'CIC-IDS-2017/' détecté.\")\n",
    "\n",
    "# 3. Détection Hardware\n",
    "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "print(f\"[INFO] Unité de calcul active : {DEVICE}\")\n",
    "if DEVICE.type == 'cuda':\n",
    "    print(f\"[INFO] GPU : {torch.cuda.get_device_name(0)}\")\n",
    "\n",
    "# Exécution du Setup\n",
    "set_seed(SEED)\n",
    "setup_env()\n",
    "\n",
    "# Configuration Pandas pour meilleure lisibilité\n",
    "pd.set_option('display.max_columns', None)\n",
    "pd.set_option('display.width', 1000)"
   ]
  },
