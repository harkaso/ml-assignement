    "class IDS_Dataset(Dataset):\n",
    "    def __init__(self, X, y):\n",
    "        self.X = torch.tensor(X, dtype=torch.float32)\n",
    "        # On garde y en float pour BCEWithLogitsLoss (Target doit être float)\n",
    "        self.y = torch.tensor(y, dtype=torch.float32).unsqueeze(1) \n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.X)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        return self.X[idx], self.y[idx]\n",
    "\n",
    "def get_dataloaders(data_dict, batch_size=256):\n",
    "    \"\"\"\n",
    "    Crée les DataLoaders pour Train, et Test.\n",
    "    Calcule aussi le poids de la classe positive pour la Loss.\n",
    "    \"\"\"\n",
    "    # Création des Datasets\n",
    "    train_ds = IDS_Dataset(data_dict['X_train'], data_dict['y_train'])\n",
    "    test_ds = IDS_Dataset(data_dict['X_test'], data_dict['y_test'])\n",
    "    \n",
    "    # Création des Loaders\n",
    "    train_loader = DataLoader(train_ds, batch_size=batch_size, shuffle=True, pin_memory=True)\n",
    "    test_loader = DataLoader(test_ds, batch_size=batch_size, shuffle=False, pin_memory=True)\n",
    "    \n",
    "    # Calcul du pos_weight pour gérer le déséquilibre\n",
    "    n_pos = data_dict['y_train'].sum()\n",
    "    n_neg = len(data_dict['y_train']) - n_pos\n",
    "    if n_pos == 0:\n",
    "        pos_weight = torch.tensor([1.0])\n",
    "    else:\n",
    "        pos_weight = torch.tensor([n_neg / n_pos])\n",
    "    \n",
    "    print(f\"[INFO] DataLoaders créés. Batch size: {batch_size}\")\n",
    "    print(f\"[INFO] Class Imbalance Weight (pos_weight): {pos_weight.item():.2f}\")\n",
    "    \n",
    "    return train_loader, test_loader, pos_weight\n",
    "\n",
    "BATCH_SIZE = 4096\n",
    "\n",
    "print(\"--- DataLoaders LINUX ---\")\n",
    "train_loader_l, test_loader_l, pos_weight_l = get_dataloaders(data_linux, batch_size=BATCH_SIZE)\n",
    "\n",
    "print(\"\\n--- DataLoaders PI ---\")\n",
    "train_loader_p, test_loader_p, pos_weight_p = get_dataloaders(data_pi, batch_size=BATCH_SIZE)\n",
    "\n",
    "print(f\"Nombre total de lignes chargées (RAM) : {len(data_linux['X_train']) + len(data_linux['X_test'])}\")\n",
    "print(f\"Nombre de batches par époque (Train)  : {len(train_loader_l)}\")\n",
    "print(f\"Lignes vues par époque (calculé)      : {len(train_loader_l) * BATCH_SIZE}\")"
   ]
  },
