   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import joblib\n",
    "import os\n",
    "\n",
    "def preprocess_for_inference(csv_path, mode='linux', models_dir='datasets'):\n",
    "    \"\"\"\n",
    "    Nettoie et prépare les données EXACTEMENT comme l'entraînement.\n",
    "    \"\"\"\n",
    "    print(f\"--- 🧹 Démarrage du pré-traitement ({mode.upper()}) ---\")\n",
    "    \n",
    "    # 1. Chargement des artefacts (C'est l'équivalent de get_uncorrelated_features et fit)\n",
    "    try:\n",
    "        scaler_path = os.path.join(models_dir, f'scaler_{mode}.pkl')\n",
    "        features_path = os.path.join(models_dir, f'features_{mode}_list.pkl')\n",
    "        \n",
    "        scaler = joblib.load(scaler_path)\n",
    "        saved_features = joblib.load(features_path) # C'est ICI qu'on récupère le résultat de la corrélation\n",
    "        print(f\"[INFO] Scaler et liste de features chargés depuis {models_dir}\")\n",
    "    except FileNotFoundError as e:\n",
    "        raise FileNotFoundError(f\"Fichiers manquants : {e}. Lance l'entraînement d'abord !\")\n",
    "\n",
    "    # 2. Chargement du CSV\n",
    "    if not os.path.exists(csv_path):\n",
    "        raise FileNotFoundError(f\"Le fichier {csv_path} n'existe pas.\")\n",
    "    \n",
    "    # skipinitialspace=True pour matcher l'entraînement\n",
    "    df = pd.read_csv(csv_path, skipinitialspace=True) \n",
    "    \n",
    "    # 3. Nettoyage Identique à l'entraînement\n",
    "    df.columns = df.columns.str.strip() # Match: df.columns.str.strip()\n",
    "    \n",
    "    # Note: On ne drop PAS les doublons en inférence (on veut voir toutes les attaques passer)\n",
    "    \n",
    "    # Suppression des colonnes inutiles (Optionnel car le filtre final le fera, mais c'est plus propre)\n",
    "    cols_to_drop = ['Flow ID', 'Source IP', 'Source Port', 'Destination IP', 'Timestamp', 'Destination Port', 'Fwd Header Length.1']\n",
    "    df = df.drop(columns=[c for c in cols_to_drop if c in df.columns], errors='ignore')\n",
    "\n",
    "    # 4. Gestion des Infinis (Même logique : Clipping)\n",
    "    # On utilise la syntaxe moderne sans 'inplace' pour éviter les warnings\n",
    "    num_cols = df.select_dtypes(include=[np.number]).columns\n",
    "    for col in num_cols:\n",
    "        if np.isinf(df[col]).any():\n",
    "            # En inférence, on prend le max local ou une grande valeur par défaut si tout est infini\n",
    "            max_val = df.loc[~np.isinf(df[col]), col].max()\n",
    "            if pd.isna(max_val): max_val = 1e9 # Sécurité si tout est infini\n",
    "            df[col] = df[col].replace([np.inf, -np.inf], max_val)\n",
    "\n",
    "    # 5. Gestion des NaN\n",
    "    # Différence OBLIGATOIRE : On ne peut pas dropna() en live (on perdrait le paquet), on remplit par 0\n",
    "    df = df.fillna(0)\n",
    "\n",
    "    # 6. Alignement des Features (L'équivalent de la sélection après corrélation)\n",
    "    # On s'assure qu'on a exactement les colonnes décidées par get_uncorrelated_features\n",
    "    \n",
    "    # Création d'un DF vide avec la bonne structure\n",
    "    df_aligned = pd.DataFrame(columns=saved_features)\n",
    "    \n",
    "    # On remplit avec ce qu'on a\n",
    "    common_cols = list(set(df.columns) & set(saved_features))\n",
    "    if common_cols:\n",
    "        df_aligned.loc[:, common_cols] = df.loc[:, common_cols]\n",
    "    \n",
    "    # On remplit le reste (colonnes manquantes dans la capture) par 0\n",
    "    df_aligned = df_aligned.fillna(0)\n",
    "    \n",
    "    # On force l'ordre exact\n",
    "    df_final = df_aligned[saved_features]\n",
    "\n",
    "    print(f\"[INFO] Données alignées : {df_final.shape}\")\n",
    "\n",
    "    # 7. Scaling (Transform uniquement)\n",
    "    X_scaled = scaler.transform(df_final)\n",
    "    \n",
    "    # 8. Conversion float32\n",
    "    X_final = X_scaled.astype(np.float32)\n",
    "    \n",
    "    print(\">>> ✅ Données prêtes.\")\n",
    "    return X_final"
   ]
  },
