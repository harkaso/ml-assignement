    "def get_uncorrelated_features(df, threshold=0.95):\n",
    "    \"\"\"Retourne la liste des colonnes à garder (non corrélées).\"\"\"\n",
    "    corr_matrix = df.corr().abs()\n",
    "    upper = corr_matrix.where(np.triu(np.ones(corr_matrix.shape), k=1).astype(bool))\n",
    "    to_drop = [column for column in upper.columns if any(upper[column] > threshold)]\n",
    "    \n",
    "    return [c for c in df.columns if c not in to_drop]\n",
    "\n",
    "def load_and_process_data(input_dir='CIC-IDS-2017/', save_scalers=False):\n",
    "    print(\">>> DÉMARRAGE DU TRAITEMENT DES DONNÉES...\")\n",
    "    \n",
    "    all_files = glob.glob(os.path.join(input_dir, \"*.csv\"))\n",
    "    if not all_files:\n",
    "        raise FileNotFoundError(f\"Aucun fichier CSV trouvé dans {input_dir}\")\n",
    "    \n",
    "    print(f\"[INFO] {len(all_files)} fichiers détectés. Chargement en cours...\")\n",
    "    \n",
    "    df_list = []\n",
    "    for f in all_files:\n",
    "        try:\n",
    "            df_chunk = pd.read_csv(f, skipinitialspace=True) \n",
    "            df_list.append(df_chunk)\n",
    "            print(f\"   -> Chargé : {os.path.basename(f)} ({df_chunk.shape})\")\n",
    "        except Exception as e:\n",
    "            print(f\"   [ERREUR] Impossible de lire {f}: {e}\")\n",
    "            \n",
    "    df = pd.concat(df_list, ignore_index=True)\n",
    "    df.columns = df.columns.str.strip()\n",
    "    initial_rows = len(df)\n",
    "    print(f\"[INFO] Dataset Brut Fusionné : {df.shape}\")\n",
    "    \n",
    "    cols_to_drop = ['Flow ID', 'Source IP', 'Source Port', 'Destination IP', 'Timestamp', 'Destination Port', 'Fwd Header Length.1']\n",
    "    \n",
    "    df.drop(columns=[c for c in cols_to_drop if c in df.columns], inplace=True)\n",
    "\n",
    "    num_cols = df.select_dtypes(include=[np.number]).columns\n",
    "    \n",
    "    for col in num_cols:\n",
    "        if np.isinf(df[col]).any():\n",
    "            max_val = df.loc[~np.isinf(df[col]), col].max()\n",
    "            if pd.isna(max_val): max_val = 1e9\n",
    "            df[col] = df[col].replace([np.inf, -np.inf], max_val)\n",
    "    df.dropna(inplace=True)\n",
    "    \n",
    "    print(f\"[INFO] Lignes supprimées (NaN/Inf) : {initial_rows - len(df)}\")\n",
    "    print(\"[INFO] Encodage des Labels...\")\n",
    "    df['Label'] = df['Label'].apply(lambda x: 0 if str(x).strip() == 'BENIGN' else 1)\n",
    "    y = df['Label']\n",
    "    \n",
    "    n_benign = (y == 0).sum()\n",
    "    n_malicious = (y == 1).sum()\n",
    "    alpha_calc = n_benign / (n_benign + n_malicious)\n",
    "    \n",
    "    dist = df['Label'].value_counts(normalize=True)\n",
    "    print(f\"[STAT] Distribution : Benign={dist[0]:.2%}, Malicious={dist[1]:.2%}\")\n",
    "    \n",
    "    feat_linux_ok = [f for f in features_linux if f in df.columns]\n",
    "    feat_pi_ok = [f for f in features_pi if f in df.columns]\n",
    "    X_linux = df[feat_linux_ok]\n",
    "    X_pi = df[feat_pi_ok]\n",
    "    \n",
    "    variance = X_linux.var()\n",
    "    const_cols = variance[variance == 0].index\n",
    "    if len(const_cols) > 0:\n",
    "        X_linux = X_linux.drop(columns=const_cols)\n",
    "        \n",
    "    var_p = X_pi.var()\n",
    "    const_cols_p = var_p[var_p == 0].index\n",
    "    if len(const_cols_p) > 0:\n",
    "        X_pi.drop(columns=const_cols_p, inplace=True)\n",
    "        \n",
    "    cols_linux_clean = get_uncorrelated_features(X_linux, threshold=0.98)\n",
    "    X_linux = X_linux[cols_linux_clean]\n",
    "    cols_pi_clean = get_uncorrelated_features(X_pi, threshold=0.95)\n",
    "    X_pi = X_pi[cols_pi_clean]\n",
    "\n",
    "    print(f\"[INFO] Dimensions Finales -> Linux: {X_linux.shape}, Pi: {X_pi.shape}\")\n",
    "    print(\"\\t-> Features Linux Finales :\", X_linux.columns.tolist())\n",
    "    dropped_linux = list(set(RAW_COLUMNS) - set(X_linux.columns.tolist()))\n",
    "    dropped_pi = list(set(RAW_COLUMNS) - set(X_pi.columns.tolist()))\n",
    "    print(f\"\\t>>> Features supprimées ({len(dropped_linux)}) :\", dropped_linux)\n",
    "    print(\"\\t-> Features Pi Finales    :\", X_pi.columns.tolist())\n",
    "    print(f\"\\t>>> Features supprimées ({len(dropped_pi)}) :\", dropped_pi)\n",
    "\n",
    "    data_linux = {}\n",
    "    data_pi = {}\n",
    "    \n",
    "    # --- TRAITEMENT LINUX ---\n",
    "    print(\"--- Processing Linux Data ---\")\n",
    "    X_train_l, X_test_l, y_train_l, y_test_l = train_test_split(X_linux, y, test_size=0.22, stratify=y, random_state=SEED)\n",
    "    \n",
    "    scaler_l = QuantileTransformer()\n",
    "    X_train_l_scaled = scaler_l.fit_transform(X_train_l)\n",
    "    X_test_l_scaled = scaler_l.transform(X_test_l)\n",
    "    \n",
    "    data_linux = {\n",
    "        'X_train': X_train_l_scaled, 'y_train': y_train_l.values,\n",
    "        'X_test': X_test_l_scaled,   'y_test': y_test_l.values,\n",
    "        'features': X_linux.columns.tolist(), 'alpha': alpha_calc\n",
    "    }\n",
    "    \n",
    "    if save_scalers:\n",
    "        joblib.dump(scaler_l, 'datasets/scaler_linux.pkl')\n",
    "        joblib.dump(X_linux.columns.tolist(), 'datasets/features_linux_list.pkl')\n",
    "        print(\"[SAVE] scaler_linux.pkl sauvegardé.\")\n",
    "\n",
    "    # --- TRAITEMENT PI ---\n",
    "    print(\"--- Processing Pi Data ---\")\n",
    "    X_train_p, X_test_p, y_train_p, y_test_p = train_test_split(X_pi, y, test_size=0.22, stratify=y, random_state=SEED)\n",
    "    \n",
    "    scaler_p = QuantileTransformer()\n",
    "    X_train_p_scaled = scaler_p.fit_transform(X_train_p)\n",
    "    X_test_p_scaled = scaler_p.transform(X_test_p)\n",
    "    \n",
    "    data_pi = {\n",
    "        'X_train': X_train_p_scaled, 'y_train': y_train_p.values,\n",
    "        'X_test': X_test_p_scaled,   'y_test': y_test_p.values,\n",
    "        'features': X_pi.columns.tolist(), 'alpha': alpha_calc\n",
    "    }\n",
    "    \n",
    "    if save_scalers:\n",
    "        joblib.dump(scaler_p, 'datasets/scaler_pi.pkl')\n",
    "        joblib.dump(X_pi.columns.tolist(), 'datasets/features_pi_list.pkl')\n",
    "        print(\"[SAVE] scaler_pi.pkl sauvegardé.\")\n",
    "        \n",
    "    return data_linux, data_pi, X_linux.columns.tolist(), X_pi.columns.tolist()\n",
    "\n",
    "try:\n",
    "    data_linux, data_pi, X_linux, X_pi = load_and_process_data(input_dir='CIC-IDS-2017/', save_scalers=True) # type: ignore\n",
    "    print(\">>> PRÉPARATION TERMINÉE AVEC SUCCÈS.\")\n",
    "except FileNotFoundError as e:\n",
    "    print(f\"[STOP] {e}\")\n",
    "    print(\"Veuillez placer le dataset dans le dossier CIC-IDS-2017/ avant de continuer.\")"
   ]
