    "\n",
    "def get_feature_info(col_name):\n",
    "    # Try exact match or match derived names\n",
    "    meta = features_metadata.get(col_name)\n",
    "    if not meta:\n",
    "        return {'Name': col_name, 'Type': 'Unknown', 'Description': 'Feature not manually mapped', 'Level': 'Unknown', 'Relevance': 'Unknown'}\n",
    "    return {\n",
    "        'Name': col_name,\n",
    "        'Type': meta['type'],\n",
    "        'Description': meta['desc'],\n",
    "        'Level': meta['level'],\n",
    "        'Relevance': meta['relevance']\n",
    "    }\n",
    "\n",
    "if 'df' in locals():\n",
    "    feature_list_data = [get_feature_info(col) for col in df.columns] # type: ignore\n",
    "    df_features = pd.DataFrame(feature_list_data)\n",
    "    display(df_features)\n"
   ]
