   "source": [
    "%%script false --no-raise-error\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import time\n",
    "import sys\n",
    "from scapy.all import sniff, conf\n",
    "from scapy.layers.inet import IP, TCP, UDP\n",
    "from collections import defaultdict\n",
    "\n",
    "# ==============================================================================\n",
    "# 1. CONFIGURATION\n",
    "# ==============================================================================\n",
    "\n",
    "MODE = 'linux'\n",
    "\n",
    "INTERFACE = conf.iface\n",
    "OUTPUT_FILE = f\"capture_{MODE}.csv\"\n",
    "\n",
    "TARGET_FEATURES = features_linux if MODE == 'linux' else features_pi if MODE == 'pi' else None\n",
    "if TARGET_FEATURES is None:\n",
    "    raise ValueError()\n",
    "\n",
    "# ==============================================================================\n",
    "# 2. MOTEUR DE FLUX (Optimisé)\n",
    "# ==============================================================================\n",
    "class Flow:\n",
    "    def __init__(self, src_ip, dst_ip, src_port, dst_port, protocol):\n",
    "        self.src_ip, self.dst_ip = src_ip, dst_ip\n",
    "        self.src_port, self.dst_port = src_port, dst_port\n",
    "        self.protocol = protocol\n",
    "        \n",
    "        self.start_time = time.time()\n",
    "        self.last_timestamp = self.start_time\n",
    "        \n",
    "        # Structures de données\n",
    "        self.fwd_pkt_lens = []\n",
    "        self.bwd_pkt_lens = []\n",
    "        self.fwd_iat = []\n",
    "        self.bwd_iat = []\n",
    "        self.flow_iat = []\n",
    "        \n",
    "        self.fwd_header_len = 0\n",
    "        self.bwd_header_len = 0\n",
    "        self.flags = defaultdict(int)\n",
    "        self.init_win_fwd = 0\n",
    "        self.init_win_bwd = 0\n",
    "        self.act_data_pkt_fwd = 0\n",
    "        self.min_seg_size_fwd = 0\n",
    "        \n",
    "    def update(self, packet, direction):\n",
    "        current_time = time.time()\n",
    "        \n",
    "        # 1. Calcul IAT (Temps inter-arrivé) - Correction temps négatifs\n",
    "        iat = abs(current_time - self.last_timestamp) * 1_000_000 \n",
    "        self.flow_iat.append(iat)\n",
    "        self.last_timestamp = current_time\n",
    "        \n",
    "        # 2. Extraction Payload & Headers\n",
    "        payload_len = 0\n",
    "        header_len = 0\n",
    "        \n",
    "        if TCP in packet:\n",
    "            payload_len = len(packet[TCP].payload)\n",
    "            header_len = packet[TCP].dataofs * 4\n",
    "            \n",
    "            # Fenêtre TCP (Window Size)\n",
    "            if direction == 'fwd' and self.init_win_fwd == 0:\n",
    "                self.init_win_fwd = packet[TCP].window\n",
    "            elif direction == 'bwd' and self.init_win_bwd == 0:\n",
    "                self.init_win_bwd = packet[TCP].window\n",
    "            \n",
    "            # Drapeaux TCP (Flags)\n",
    "            flags = packet[TCP].flags\n",
    "            # Mapping Scapy -> Noms Features\n",
    "            if 'F' in flags: self.flags['FIN'] += 1\n",
    "            if 'S' in flags: self.flags['SYN'] += 1\n",
    "            if 'R' in flags: self.flags['RST'] += 1\n",
    "            if 'P' in flags: self.flags['PSH'] += 1\n",
    "            if 'A' in flags: self.flags['ACK'] += 1\n",
    "            if 'U' in flags: self.flags['URG'] += 1\n",
    "            if 'E' in flags: self.flags['ECE'] += 1\n",
    "            if 'C' in flags: self.flags['CWR'] += 1 # CWE dans dataset\n",
    "\n",
    "        elif UDP in packet:\n",
    "            payload_len = len(packet[UDP].payload)\n",
    "            header_len = 8 # Header UDP fixe\n",
    "\n",
    "        # 3. Stockage selon direction\n",
    "        if direction == 'fwd':\n",
    "            self.fwd_pkt_lens.append(payload_len)\n",
    "            self.fwd_header_len += header_len\n",
    "            self.min_seg_size_fwd = header_len\n",
    "            if len(self.fwd_iat) > 0: self.fwd_iat.append(iat)\n",
    "            if payload_len > 0: self.act_data_pkt_fwd += 1\n",
    "        else:\n",
    "            self.bwd_pkt_lens.append(payload_len)\n",
    "            self.bwd_header_len += header_len\n",
    "            if len(self.bwd_iat) > 0: self.bwd_iat.append(iat)\n",
    "\n",
    "    def get_features(self):\n",
    "        \"\"\"Calcule et retourne uniquement les features demandées par TARGET_FEATURES\"\"\"\n",
    "        \n",
    "        # Conversion numpy pour calculs vectoriels rapides\n",
    "        fl = np.array(self.fwd_pkt_lens) if self.fwd_pkt_lens else np.array([0])\n",
    "        bl = np.array(self.bwd_pkt_lens) if self.bwd_pkt_lens else np.array([0])\n",
    "        all_len = np.concatenate((fl, bl))\n",
    "        \n",
    "        # Durée (Force positive)\n",
    "        duration = abs(time.time() - self.start_time) * 1_000_000\n",
    "        if duration == 0: duration = 1 \n",
    "\n",
    "        total_pkts = len(fl) + len(bl)\n",
    "        total_bytes = np.sum(fl) + np.sum(bl)\n",
    "        \n",
    "        # Dictionnaire complet (Calcul de toutes les métriques possibles)\n",
    "        # On calcule tout ici pour simplifier le code, puis on filtre à la fin\n",
    "        \n",
    "        # Stats IAT (Nécessaire seulement pour Linux, mais calcul rapide)\n",
    "        flow_iat = np.array(self.flow_iat) if self.flow_iat else np.array([0])\n",
    "        fiat = np.array(self.fwd_iat) if self.fwd_iat else np.array([0])\n",
    "        biat = np.array(self.bwd_iat) if self.bwd_iat else np.array([0])\n",
    "\n",
    "        data = {\n",
    "            # --- BASE (Commun Pi & Linux) ---\n",
    "            'Flow Duration': duration,\n",
    "            'Total Fwd Packets': len(fl),\n",
    "            'Total Backward Packets': len(bl),\n",
    "            'Total Length of Fwd Packets': np.sum(fl),\n",
    "            'Total Length of Bwd Packets': np.sum(bl),\n",
    "            'Fwd Packet Length Max': np.max(fl), 'Fwd Packet Length Min': np.min(fl),\n",
    "            'Bwd Packet Length Max': np.max(bl), 'Bwd Packet Length Min': np.min(bl),\n",
    "            'Flow Bytes/s': (total_bytes / duration) * 1e6,\n",
    "            'Flow Packets/s': (total_pkts / duration) * 1e6,\n",
    "            'Fwd Header Length': self.fwd_header_len, 'Bwd Header Length': self.bwd_header_len,\n",
    "            'Fwd Packets/s': (len(fl)/duration)*1e6, 'Bwd Packets/s': (len(bl)/duration)*1e6,\n",
    "            'Min Packet Length': np.min(all_len), 'Max Packet Length': np.max(all_len),\n",
    "            'FIN Flag Count': self.flags['FIN'], 'SYN Flag Count': self.flags['SYN'],\n",
    "            'PSH Flag Count': self.flags['PSH'], 'ACK Flag Count': self.flags['ACK'],\n",
    "            'Down/Up Ratio': len(bl)/len(fl) if len(fl) > 0 else 0,\n",
    "            'Average Packet Size': np.mean(all_len),\n",
    "            'Init_Win_bytes_forward': self.init_win_fwd, 'Init_Win_bytes_backward': self.init_win_bwd,\n",
    "            'act_data_pkt_fwd': self.act_data_pkt_fwd, 'min_seg_size_forward': self.min_seg_size_fwd,\n",
    "            \n",
    "            # --- AVANCÉ (Spécifique Linux / Full) ---\n",
    "            'Fwd Packet Length Mean': np.mean(fl), 'Fwd Packet Length Std': np.std(fl),\n",
    "            'Bwd Packet Length Mean': np.mean(bl), 'Bwd Packet Length Std': np.std(bl),\n",
    "            'Flow IAT Mean': np.mean(flow_iat), 'Flow IAT Std': np.std(flow_iat),\n",
    "            'Flow IAT Max': np.max(flow_iat), 'Flow IAT Min': np.min(flow_iat),\n",
    "            'Fwd IAT Total': np.sum(fiat), 'Fwd IAT Mean': np.mean(fiat),\n",
    "            'Fwd IAT Std': np.std(fiat), 'Fwd IAT Max': np.max(fiat), 'Fwd IAT Min': np.min(fiat),\n",
    "            'Bwd IAT Total': np.sum(biat), 'Bwd IAT Mean': np.mean(biat),\n",
    "            'Bwd IAT Std': np.std(biat), 'Bwd IAT Max': np.max(biat), 'Bwd IAT Min': np.min(biat),\n",
    "            'Fwd PSH Flags': self.flags['PSH'], 'Bwd PSH Flags': 0,\n",
    "            'Packet Length Mean': np.mean(all_len), 'Packet Length Std': np.std(all_len),\n",
    "            'Packet Length Variance': np.var(all_len),\n",
    "            'RST Flag Count': self.flags['RST'], 'URG Flag Count': self.flags['URG'],\n",
    "            'ECE Flag Count': self.flags['ECE'], 'CWE Flag Count': self.flags['CWR'],\n",
    "        }\n",
    "        \n",
    "        # FILTRAGE FINAL : On ne garde que les colonnes demandées par le MODE\n",
    "        # On utilise .get(col, 0) pour remplir par 0 si une colonne manque (sécurité)\n",
    "        return {col: data.get(col, 0) for col in TARGET_FEATURES}\n",
    "\n",
    "# ==============================================================================\n",
    "# 3. GESTIONNAIRE DE CAPTURE\n",
    "# ==============================================================================\n",
    "active_flows = {}\n",
    "\n",
    "def get_flow_key(pkt):\n",
    "    \"\"\"Clé unique : (IP_Src, Port_Src, IP_Dst, Port_Dst, Proto)\"\"\"\n",
    "    if TCP in pkt:\n",
    "        proto, sport, dport = 6, pkt[TCP].sport, pkt[TCP].dport\n",
    "    elif UDP in pkt:\n",
    "        proto, sport, dport = 17, pkt[UDP].sport, pkt[UDP].dport\n",
    "    else:\n",
    "        return None, None\n",
    "        \n",
    "    src, dst = pkt[IP].src, pkt[IP].dst\n",
    "    \n",
    "    # On normalise la clé pour que A->B et B->A tombent dans le même flux\n",
    "    key_fwd = (src, sport, dst, dport, proto)\n",
    "    key_bwd = (dst, dport, src, sport, proto)\n",
    "    \n",
    "    if key_fwd in active_flows: return key_fwd, 'fwd'\n",
    "    elif key_bwd in active_flows: return key_bwd, 'bwd'\n",
    "    else: return key_fwd, 'new'\n",
    "\n",
    "def packet_callback(pkt):\n",
    "    if IP not in pkt: return\n",
    "    try:\n",
    "        key, direction = get_flow_key(pkt)\n",
    "        if not key: return\n",
    "\n",
    "        if direction == 'new':\n",
    "            # Nouveau flux détecté\n",
    "            active_flows[key] = Flow(key[0], key[2], key[1], key[3], key[4])\n",
    "            direction = 'fwd'\n",
    "        \n",
    "        active_flows[key].update(pkt, direction)\n",
    "        \n",
    "        # Feedback visuel léger\n",
    "        print(f\"[{MODE.upper()}] Flux actifs: {len(active_flows)} | Features: {len(TARGET_FEATURES)}\", end='\\r')\n",
    "        \n",
    "    except Exception as e:\n",
    "        pass\n",
    "\n",
    "# ==============================================================================\n",
    "# 4. EXÉCUTION\n",
    "# ==============================================================================\n",
    "print(\"=\"*60)\n",
    "print(f\"🚀 DÉMARRAGE DU CAPTURE TOOL - MODE: {MODE.upper()}\")\n",
    "print(f\"📡 Interface: {INTERFACE}\")\n",
    "print(f\"📋 Colonnes cibles: {len(TARGET_FEATURES)}\")\n",
    "print(f\"💾 Sortie: {OUTPUT_FILE}\")\n",
    "print(\"=\"*60)\n",
    "print(\"Appuie sur [Ctrl+C] pour arrêter la capture et sauvegarder.\")\n",
    "\n",
    "try:\n",
    "    sniff(iface=INTERFACE, prn=packet_callback, store=0)\n",
    "except KeyboardInterrupt:\n",
    "    print(\"\\n\\n🛑 Capture arrêtée par l'utilisateur.\")\n",
    "except OSError:\n",
    "    print(f\"\\n❌ ERREUR CRITIQUE: L'interface '{INTERFACE}' est introuvable.\")\n",
    "    sys.exit(1)\n",
    "\n",
    "# --- SAUVEGARDE ---\n",
    "print(\"Traitement des données et génération CSV...\")\n",
    "data_rows = []\n",
    "\n",
    "# On ne garde que les flux significatifs (plus de 1 paquet ou taille > 0)\n",
    "for key, flow in active_flows.items():\n",
    "    if len(flow.fwd_pkt_lens) + len(flow.bwd_pkt_lens) > 1:\n",
    "        data_rows.append(flow.get_features())\n",
    "\n",
    "if data_rows:\n",
    "    df = pd.DataFrame(data_rows)\n",
    "    # Réorganisation pour matcher l'ordre exact de la liste\n",
    "    df = df.reindex(columns=TARGET_FEATURES, fill_value=0)\n",
    "    df.to_csv(OUTPUT_FILE, index=False)\n",
    "    \n",
    "    print(f\"✅ SUCCÈS : {len(df)} flux sauvegardés dans '{OUTPUT_FILE}'\")\n",
    "    \n",
    "    # Vérification rapide\n",
    "    if (df['Flow Duration'] < 0).any():\n",
    "        print(\"⚠️ ATTENTION: Il reste des durées négatives ! (Bug possible)\")\n",
    "    else:\n",
    "        print(\"👍 Vérification : Aucune durée négative détectée.\")\n",
    "else:\n",
    "    print(\"⚠️ Aucun trafic significatif capturé.\")"
   ]
  },
