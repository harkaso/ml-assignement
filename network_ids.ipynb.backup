   "source": [
    "print(\"\\n=== 🏆 TABLEAU COMPARATIF FINAL ===\")\n",
    "df_results = pd.DataFrame(results_log)\n",
    "df_results['F1-Score'] = df_results['F1-Score'].astype(float)\n",
    "df_results['Accuracy'] = df_results['Accuracy'].astype(float)\n",
    "df_results['Precision'] = df_results['Precision'].astype(float)\n",
    "df_results['Recall'] = df_results['Recall'].astype(float)\n",
    "df_results['ROC-AUC'] = df_results['ROC-AUC'].astype(float)\n",
    "df_results['FPR'] = df_results['FPR'].astype(float)\n",
    "df_results['Inference'] = df_results['Inference'].astype(float)\n",
    "df_results['Size'] = df_results['Size'].astype(float)\n",
    "df_results['Memory Peak'] = df_results['Memory Peak'].astype(float)\n",
    "df_results['Train Time'] = df_results['Train Time'].astype(float)\n",
    "\n",
    "display_cols = [\n",
    "    'Arch', 'Platform', 'Accuracy', 'Precision', 'Recall', \n",
    "    'F1-Score', 'ROC-AUC', 'FPR', \n",
    "    'Inference', 'Size', 'Memory Peak', 'Train Time'\n",
    "]\n",
    "\n",
    "def highlight_best(s):\n",
    "    is_max = s == s.max()\n",
    "    is_min = s == s.min()\n",
    "    if s.name in ['FPR', 'Inference', 'Size', 'Memory Peak', 'Train Time']:\n",
    "        return ['background-color: #d4edda' if v else '' for v in is_min]\n",
    "    else:\n",
    "        return ['background-color: #d4edda' if v else '' for v in is_max]\n",
    "\n",
    "styled_df = df_results[display_cols].style.apply(highlight_best, subset=display_cols[2:])\\\n",
    "             .format(\"{:.4f}\", subset=['Accuracy', 'Precision', 'Recall', 'F1-Score', 'ROC-AUC', 'FPR'])\n",
    "\n",
    "display(styled_df)\n",
    "df_results.to_csv(\"models/benchmark_results.csv\", index=False)\n",
    "df_melted = df_results.melt(id_vars=['Platform', 'Arch'], value_vars=['F1-Score', 'Recall'], var_name='Metric', value_name='Score')\n",
    "\n",
    "\n",
    "df_metrics = df_results.melt(\n",
    "    id_vars=['Arch', 'Platform'], \n",
    "    value_vars=['Accuracy', 'F1-Score', 'Precision', 'Recall', 'ROC-AUC'], \n",
    "    var_name='Metric', \n",
    "    value_name='Score'\n",
    ")\n",
    "sns.set_theme(style=\"whitegrid\", font_scale=1.1)\n",
    "g = sns.catplot(\n",
    "    data=df_metrics, \n",
    "    kind=\"bar\",\n",
    "    x=\"Arch\", \n",
    "    y=\"Score\", \n",
    "    hue=\"Metric\", \n",
    "    col=\"Platform\",\n",
    "    height=6, \n",
    "    aspect=1.2,\n",
    "    palette=\"viridis\",\n",
    "    edgecolor=\"black\",\n",
    "    linewidth=1\n",
    ")\n",
    "g.figure.subplots_adjust(top=0.85)\n",
    "g.figure.suptitle(\"Comparaison Détaillée\", fontsize=16, fontweight='bold')\n",
    "for ax in g.axes.flat:\n",
    "    ax.set_ylim(0.0, 1.01) \n",
    "    for container in ax.containers:\n",
    "        ax.bar_label(container, fmt='%.3f', padding=3, fontsize=9, rotation=90)\n",
    "    ax.set_ylabel(\"Score (0.0 - 1.0)\")\n",
    "    ax.set_xlabel(\"Architecture\")\n",
    "    ax.grid(axis='y', linestyle='--', alpha=0.7)\n",
    "plt.show()\n",
    "\n",
    "print(\"✅ Benchmarks terminés. Résultats sauvegardés dans 'models/benchmark_results.csv'.\")\n"
   ]
  },
